{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=shopverse;Username=shopverse;Password=shopverse_secret;",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "ShopVerse_"
  },
  "Jwt": {
    "Secret": "super_secret_mechware_256bit_production_ready_jwt_key_here_for_local_dev",
    "Issuer": "https://api.mechware.com.bd",
    "Audience": "https://mechware.com.bd",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minio_admin",
    "SecretKey": "minio_secret_password",
    "PublicBucket": "mechware-public",
    "PrivateKycBucket": "mechware-private-kyc"
  },
  "AllowedHosts": "*"
}
