# Copy to staging.env (git-ignored) and fill in. No real secrets belong in this example file.
# Generate: JWT_SECRET -> openssl rand -base64 48 ; ENCRYPTION_FIELD_KEY -> openssl rand -base64 32
#           GUEST_CART_TOKEN_KEY -> openssl rand -base64 32 (its own value; never reuse another key)

# --- required (compose refuses to start without them) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_FIELD_KEY=
GUEST_CART_TOKEN_KEY=
MEILI_MASTER_KEY=
EMAIL_FROM_ADDRESS=noreply@example.invalid
STOREFRONT_BASE_URL=https://staging.example.invalid
PUBLIC_API_BASE_URL=https://api.staging.example.invalid

# --- optional ---
JWT_ISSUER=https://api.staging.example.invalid
JWT_AUDIENCE=https://staging.example.invalid
EMAIL_HOST=mailpit
EMAIL_PORT=1025
GOOGLE_CLIENT_ID=
CONSOLE_BASE_URL=https://console.staging.example.invalid
FORWARDED_KNOWN_PROXIES=
API_PORT=8080
WEB_PORT=3000
CONSOLE_PORT=3001
MAILPIT_UI_PORT=8025
# Encrypts the Data Protection keys at rest: path INSIDE the api container to a mounted PKCS#12 file with private key.
# openssl req -x509 -newkey rsa:3072 -nodes -days 1095 -subj /CN=mechware-dp -keyout dp.key -out dp.crt
# openssl pkcs12 -export -in dp.crt -inkey dp.key -out dp.pfx   (keep dp.pfx and its password in the secret store)
DATA_PROTECTION_CERT_PATH=
DATA_PROTECTION_CERT_PASSWORD=
# Guest-cart key rotation: the previous GUEST_CART_TOKEN_KEY values (comma-separated) only verify, for 7 days.
GUEST_CART_PREVIOUS_TOKEN_KEYS=
