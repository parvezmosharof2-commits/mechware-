# MECHWARE production settings. Step-by-step: docs/DEPLOY_RUNBOOK.md, step 9.
#
#   cp infra/docker/prod.env.example infra/docker/prod.env      # then edit prod.env ONLY on the server
#   chmod 600 infra/docker/prod.env
#
# Rules:
# - prod.env is git-ignored. Never commit it, never e-mail it, never paste it into a chat.
# - Keep a copy of the finished prod.env in a password manager. ENCRYPTION_FIELD_KEY in particular: without it the
#   encrypted fields in every database backup can never be read again.
# - Every CHANGE_ME must be replaced; the stack refuses to start while one is left.
# - Write text with spaces or a "#" (names, addresses) inside single quotes: KEY='House 12, Road 3'. A "#" after a space
#   in an unquoted value starts a comment and cuts the value off.
# - Make secrets ONLY with the commands shown. Run each command on the server and paste its one-line output after "=".
#   (-hex output is used where the value goes inside a connection string: it has no "+", "/" or "=").

# ===================================================================================================================
# 1. Domain and HTTPS                                                                         OWNER FILLS
# ===================================================================================================================
# The shop's domain without https:// or www. Caddy serves DOMAIN, www.DOMAIN, console.DOMAIN and api.DOMAIN.
# NOTE: the API's browser allow-list (CORS) currently names mechware.com.bd and console.mechware.com.bd only. Another
# domain needs a one-line code change first (Program.cs, AddCors), or the browser cannot call the API.
DOMAIN=CHANGE_ME.example
# Let's Encrypt sends certificate-expiry warnings here (any mailbox you read).
ACME_EMAIL=CHANGE_ME@example.invalid

# ===================================================================================================================
# 2. Secrets: generate, never invent                                                          GENERATE ON THE SERVER
# ===================================================================================================================
# openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME
# openssl rand -base64 48      (signs sign-in tokens; changing it signs everybody out)
JWT_SECRET=CHANGE_ME
# openssl rand -base64 32      (encrypts business identifiers in the database: NEVER change or lose it, see the top)
ENCRYPTION_FIELD_KEY=CHANGE_ME
# openssl rand -base64 32      (its own value: never reuse another key; signs the guest-cart cookie)
GUEST_CART_TOKEN_KEY=CHANGE_ME
# openssl rand -hex 32         (Meilisearch search engine key)
MEILI_MASTER_KEY=CHANGE_ME

# ===================================================================================================================
# 3. E-mail (SMTP)                                                                            OWNER FILLS
# ===================================================================================================================
# From the e-mail provider for the shop's domain (e.g. Zoho Mail, Google Workspace, Brevo, Amazon SES): its SMTP server,
# a user name and an app password. Use port 587 (STARTTLS) with EMAIL_USE_TLS=true; port 465 (implicit TLS) is not supported.
EMAIL_HOST=CHANGE_ME.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
# The sender buyers see, on the shop's own domain (e.g. noreply@<your domain>); the provider must allow it (SPF/DKIM).
EMAIL_FROM_ADDRESS=CHANGE_ME@example.invalid
EMAIL_FROM_NAME=MECHWARE
# Mailbox that receives "RFQ received / accepted / rejected / expired" notices (Quotes:SalesInboxEmail).
SALES_INBOX_EMAIL=CHANGE_ME@example.invalid

# ===================================================================================================================
# 4. First administrator (only for the first start)                                          OWNER FILLS
# ===================================================================================================================
# Created once when the API starts and no account with this e-mail exists. Two-factor sign-in is always on for it.
# Password: at least 8 characters with upper case, lower case, a digit and a symbol (use 16+; a password manager helps).
# TOTP secret: openssl rand 20 | base32        (32 letters A-Z and digits 2-7; type it into your authenticator app)
# After your first successful sign-in, empty these five values again and run `up -d` (runbook step 12).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# ===================================================================================================================
# 5. Mushak-6.3 invoices                                                                      OWNER FILLS (decision O1)
# ===================================================================================================================
# Off  = the shop issues no Mushak-6.3 (use the paper pad). Start with Off until every fact below is known.
# Live = real invoices; then IssuerSellerId, both legal names, BIN, both registered addresses and the responsible person
#        are REQUIRED or the API and Worker refuse to start. (Specimen is refused in production.)
INVOICING_MODE=Off
# The id of MECHWARE's own seller record (the developer reads it from the database after the first start).
INVOICING_ISSUER_SELLER_ID=
INVOICING_LEGAL_NAME_EN=
INVOICING_LEGAL_NAME_BN=
# Company BIN: 13 digits, plain or as printed (#########-####).
INVOICING_BIN=
# Optional on the form: TIN (12 digits) and trade licence number.
INVOICING_TIN=
INVOICING_TRADE_LICENCE=
# Registered address as on the BIN certificate, in English and Bangla (single quotes!).
INVOICING_REGISTERED_ADDRESS_EN=
INVOICING_REGISTERED_ADDRESS_BN=
# Only when invoices are issued from another address; blank = the registered address.
INVOICING_PREMISES_ADDRESS_EN=
INVOICING_PREMISES_ADDRESS_BN=
# The person responsible for the VAT return (name and designation).
INVOICING_RESPONSIBLE_PERSON_NAME=
INVOICING_RESPONSIBLE_PERSON_DESIGNATION=
# true only after the VAT consultant signed off; until then every invoice PDF says "consultant check".
INVOICING_CONSULTANT_CHECKED=false

# Bank details printed on invoice PDFs (from the owner's INVOICE.docx). Each line prints only when set.
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_BRANCH=
BANK_ROUTING_NUMBER=
# Who signs the invoice PDF; blank = the responsible person above.
SIGNATORY_NAME=
SIGNATORY_DESIGNATION=

# ===================================================================================================================
# 6. Backups (infra/scripts/backup.sh)                                                        OWNER FILLS THE REMOTE
# ===================================================================================================================
# Local folder for the nightly copies (on the server's own disk).
BACKUP_DIR=/var/backups/mechware
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Off-site copy with rclone, e.g. b2crypt:mechware-backups (runbook step 14). EMPTY = backups stay on this server only,
# and a disk failure or a hacked server loses the shop AND its backups. Set this before taking real orders.
BACKUP_RCLONE_REMOTE=
# Optional: a "dead man's switch" URL (e.g. healthchecks.io, free) pinged after each good backup; it e-mails you when
# the ping stops.
BACKUP_PING_URL=

# ===================================================================================================================
# 7. Optional
# ===================================================================================================================
# Google sign-in: the OAuth web client id (used by the shop and the API). Empty = the Google button is off.
GOOGLE_CLIENT_ID=
# Encrypts the Data Protection keys at rest (recommended; runbook step 10). Path INSIDE the containers:
#   DATA_PROTECTION_CERT_PATH=/run/secrets/mechware/dp.pfx   and the password you chose for dp.pfx.
DATA_PROTECTION_CERT_PATH=
DATA_PROTECTION_CERT_PASSWORD=
# Key rotation only (developer task): old values, comma-separated, kept for the stated period, then removed.
ENCRYPTION_PREVIOUS_FIELD_KEYS=
GUEST_CART_PREVIOUS_TOKEN_KEYS=
# Rate limits use the built-in defaults (RateLimiting__*: 100 requests/min per anonymous visitor, 600 per signed-in user,
# 5 login attempts/min). Changing them needs an extra line in docker-compose.prod.yml; leave them unless told otherwise.
#
# Image tag for the four MECHWARE images built on this server.
MECHWARE_TAG=prod
# Leave these unless Docker reports "Pool overlaps" (then pick another private /24 and an address inside it).
EDGE_SUBNET=172.30.10.0/24
CADDY_IP=172.30.10.10
HTTP_PORT=80
HTTPS_PORT=443
