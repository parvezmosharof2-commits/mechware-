# ==============================================================================
# MECHWARE Enterprise Commerce & Automation Platform — Environment Configuration
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL="Host=localhost;Port=5432;Database=mechware;Username=mechware;Password=mechware_secret;"
POSTGRES_USER=mechware
POSTGRES_PASSWORD=mechware_secret
POSTGRES_DB=mechware

# Cache & Distributed Locking (Redis 7)
REDIS_URL="localhost:6379,abortConnect=false"

# JWT Authentication
JWT_SECRET="super_secret_mechware_256bit_production_ready_jwt_key_here_for_local_dev"
JWT_ISSUER="https://api.mechware.com.bd"
JWT_AUDIENCE="https://mechware.com.bd"
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Object Storage (MinIO Local / AWS S3 Prod)
STORAGE_SERVICE_URL="http://localhost:9000"
STORAGE_ACCESS_KEY="minio_admin"
STORAGE_SECRET_KEY="minio_secret_password"
STORAGE_PUBLIC_BUCKET="mechware-public"
STORAGE_PRIVATE_KYC_BUCKET="mechware-private-kyc"

# Product documents (datasheets, CAD, certificates). Outside Development both are required: a directory on a persistent
# volume, and a ClamAV daemon (the compose file has one). Development falls back to a temp directory and an EICAR-only
# test scanner, which is NOT a virus scanner.
# (ASP.NET Core reads Section__Key; the underscore names above, such as STORAGE_SERVICE_URL, are only a reference list.)
Documents__LocalPath="/var/lib/mechware/documents"
Antivirus__Host="localhost"
Antivirus__Port=3310

# Search Engine (Meilisearch)
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_MASTER_KEY="meili_master_key_12345"

# AI Integration (Google Gemini)
# Stored strictly on backend server; never exposed to browser
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# Bangladesh Payment Gateways
SSLCOMMERZ_STORE_ID="mechw001"
SSLCOMMERZ_STORE_PASSWORD="mechw001_secret"
SSLCOMMERZ_IS_SANDBOX=true
BKASH_APP_KEY="bkash_test_app_key"
BKASH_APP_SECRET="bkash_test_app_secret"
BKASH_USERNAME="sandbox_user"
BKASH_PASSWORD="sandbox_password"
NAGAD_MERCHANT_ID="68219001"
NAGAD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
NAGAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."

# Frontend Public URLs
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_CONSOLE_URL="http://localhost:3001"
