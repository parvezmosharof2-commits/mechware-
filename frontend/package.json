{
  "name": "mechware-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "lint:tokens": "node packages/config/lint-tokens.mjs",
    "typecheck": "pnpm --recursive run typecheck",
    "dev:web": "pnpm --filter @mechware/web dev",
    "dev:console": "pnpm --filter @mechware/console dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.32"
    }
  }
}
